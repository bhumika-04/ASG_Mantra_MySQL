# ===========================
# Excluded folders (per policy)
# ===========================
/Data/
/database/
/docs/

# ===========================
# Python (backend)
# ===========================
backend/venv/
backend/__pycache__/
backend/**/__pycache__/
backend/**/*.pyc
backend/**/*.pyo
backend/.env
backend/*.egg-info/
backend/dist/
backend/.pytest_cache/
backend/*.log
backend/**/*.log

# Uploaded files (runtime data, not source)
backend/uploads/

# ===========================
# Node / Next.js (frontend)
# ===========================
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/build/
frontend/.env
frontend/.env.local
frontend/coverage/
frontend/.pnp
frontend/.pnp.*
frontend/.yarn/*
!frontend/.yarn/patches
!frontend/.yarn/plugins
!frontend/.yarn/releases
!frontend/.yarn/versions

# ===========================
# Root-level env files
# ===========================
/.env
/.env.*

# ===========================
# Claude Code (local settings)
# ===========================
.claude/

# ===========================
# OS / Editor
# ===========================
.DS_Store
Thumbs.db
*.bak
*.pem
.vercel
*.tsbuildinfo
next-env.d.ts
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Generated review reports
backend/scripts/*.csv
